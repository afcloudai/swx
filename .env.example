# 🔹 Environment Configuration
DOMAIN=localhost
BACKEND_HOST=http://localhost:8000
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
CORE_DEV_MODE=${CORE_DEV_MODE:-false}  # Fallback to `false` if not set

# 🔹 Detect if Running in Docker
DOCKERIZED=${DOCKERIZED:-false}  # Set to "true" in Docker

# 🔹 Project Metadata
PROJECT_NAME="SwX-API Framework"
STACK_NAME=swx-api
LOG_LEVEL=warning  # Options: debug, info, warning, error, critical

# 🔹 Security Settings
PASSWORD_SECURITY_ALGORITHM="HS256"
SECRET_KEY=${SECRET_KEY:-generate_a_secure_key}  # Fallback if missing
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_SECRET_KEY=${REFRESH_SECRET_KEY:-generate_a_secure_refresh_key}  # Fallback if missing

# 🔹 CORS Configuration (Comma-separated list)
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"

# 🔹 Database Configuration (PostgreSQL)
DATABASE_TYPE=postgres
DB_HOST=${DB_HOST:-localhost}  # Uses "db" in Docker, "localhost" locally
DB_PORT=5432
DB_USER=${DB_USER:-your-db-user}
DB_PASSWORD=${DB_PASSWORD:-your-db-password}
DB_NAME=${DB_NAME:-your-db-name}

# Dynamic DATABASE_URL for Docker compatibility
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# 🔹 Superuser Configuration
FIRST_SUPERUSER=${FIRST_SUPERUSER:-your-email@example.com}
FIRST_SUPERUSER_PASSWORD=${FIRST_SUPERUSER_PASSWORD:-your-password}

SENTRY_DSN=

# 🔹 Docker Image Configuration
SWX_API_IMAGE=swx-api

# 🔹 Email Configuration
SMTP_HOST=smtp.your-email-provider.com  # Added missing SMTP host
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587
EMAILS_FROM_EMAIL=${EMAILS_FROM_EMAIL:-your-email@example.com}
EMAILS_FROM_NAME="SwX-API Admin"

# 🔹 Social Login Configuration
ENABLE_GOOGLE_LOGIN=True
ENABLE_FACEBOOK_LOGIN=True


# 🔹 Google OAuth Configuration
GOOGLE_AUTH_URL="https://accounts.google.com/o/oauth2/v2/auth"
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID:-your-google-client-id}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET:-your-google-client-secret}
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/auth/callback
GOOGLE_REDIRECT_URIS=http://localhost:8000/api/v1/oauth/google/auth/callback,https://chat.fastpii.com/api/v1/oauth/google/auth/callback
GOOGLE_SCOPE="openid email profile"

# 🔹 Facebook OAuth Configuration
FACEBOOK_AUTH_URL="https://www.facebook.com/v12.0/dialog/oauth"
FACEBOOK_CLIENT_ID=${FACEBOOK_CLIENT_ID:-your-facebook-client-id}
FACEBOOK_CLIENT_SECRET=${FACEBOOK_CLIENT_SECRET:-your-facebook-client-secret}
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/oauth/facebook/auth/callback
FACEBOOK_REDIRECT_URIS=http://localhost:8000/api/v1/oauth/facebook/auth/callback,https://chat.fastpii.com/api/v1/oauth/facebook/auth/callback
FACEBOOK_SCOPE=email,public_profile

# 🔹 OIDC Identity Provider (SWX-IDM-001)
SWX_OIDC_ISSUER=  # absolute issuer URL (e.g. https://auth.afcloudai.com); empty = derived from base URL + ROUTE_PREFIX
SWX_OIDC_LOGIN_URL=/auth/cookie/login
SWX_OIDC_CODE_TTL_SECONDS=60
SWX_OIDC_ID_TOKEN_TTL_SECONDS=3600
SWX_OIDC_ACCESS_TTL_SECONDS=3600
SWX_OIDC_REFRESH_TTL_SECONDS=1209600
SWX_OIDC_KEY_RETIREMENT_DAYS=30
SWX_OIDC_DEFAULT_SIGNING_ALGORITHM=RS256
SWX_PHONE_VERIFICATION_CHANNEL=  # registered PhoneVerificationChannel name; empty = log only
# Recommended auth rate limits for the issuer surface (single-line JSON; see middleware/auth_rate_limit.py)
SWX_AUTH_RATE_LIMIT_RULES=[{"namespace":"oidc-token","exact_path":"/api/oidc/token","methods":["POST"],"max_requests":10,"window_seconds":60},{"namespace":"oidc-authorize","path_prefix":"/api/oidc/authorize","methods":["GET"],"max_requests":20,"window_seconds":60},{"namespace":"oidc-admin","path_prefix":"/api/admin/oidc","max_requests":30,"window_seconds":60}]
